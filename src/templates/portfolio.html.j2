<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name_ko }} · 포트폴리오</title>
  <meta name="description" content="{{ name_ko }}({{ name_en }}) {{ headline }} 포트폴리오">
  <link rel="canonical" href="{{ site_url }}">
  <style>
    :root {
      --ink: #241c33;
      --muted: #5e5672;
      --faint: #8a829c;
      --accent: #6b57a6;
      --accent-soft: #f3eefb;
      --line: #e4dcf2;
      --paper: #fffcfe;
      --bg: #f3eef8;
      --chip: #efe8f8;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      color: var(--ink);
      background: var(--bg);
      font-family: "Apple SD Gothic Neo", "Pretendard", "Noto Sans KR", "Malgun Gothic", sans-serif;
      font-size: 9.35pt;
      line-height: 1.34;
      word-break: keep-all;
      overflow-wrap: break-word;
      -webkit-font-smoothing: antialiased;
    }

    a { color: inherit; text-decoration: none; }

    .hint {
      width: min(210mm, calc(100% - 24px));
      margin: 16px 0 10px;
      color: var(--accent);
      font-size: 11px;
      letter-spacing: -0.01em;
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      margin: 0 auto 28px;
      padding: 9.5mm 10.5mm 8.5mm;
      background: var(--paper);
      box-shadow: 0 16px 50px rgba(72, 52, 112, 0.12);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    header {
      display: grid;
      grid-template-columns: 34mm 1fr;
      gap: 4.2mm;
      align-items: center;
      padding-bottom: 3.2mm;
      border-bottom: 0.45mm solid var(--accent);
    }

    .photo {
      width: 34mm;
      height: 28mm;
      object-fit: cover;
      object-position: center 42%;
      border-radius: 1.4mm;
      background: var(--accent-soft);
    }

    .name-row {
      display: flex;
      align-items: baseline;
      gap: 3mm;
    }

    h1 {
      margin: 0;
      font-size: 20pt;
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .en {
      color: var(--accent);
      font-size: 10.5pt;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .headline {
      margin: 1.3mm 0 1.4mm;
      font-size: 10pt;
      font-weight: 600;
      letter-spacing: -0.03em;
    }

    .contacts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6mm 0;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--muted);
      font-size: 8.5pt;
    }

    .contacts li {
      display: inline-flex;
      align-items: center;
    }

    .contacts li + li::before {
      content: "";
      width: 0.7mm;
      height: 0.7mm;
      margin: 0 2.1mm;
      border-radius: 50%;
      background: #c9bddf;
    }

    .contacts a:hover { color: var(--accent); }

    .columns {
      display: grid;
      grid-template-columns: 1.18fr 0.82fr;
      gap: 6mm;
      margin-top: 3.2mm;
    }

    section { margin: 0 0 2.6mm; }

    .work-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.7mm 5.5mm;
    }

    .work-title {
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.28;
    }

    .work-item .when { font-size: 7.7pt; }

    .work-item p {
      margin: 0.25mm 0 0;
      color: var(--muted);
      font-size: 8.05pt;
      line-height: 1.32;
    }
    .columns section:last-child { margin-bottom: 0; }

    h2 {
      margin: 0 0 2.4mm;
      padding-bottom: 1mm;
      border-bottom: 0.25mm solid var(--line);
      color: var(--accent);
      font-size: 9.4pt;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .item { margin: 0 0 1.8mm; }
    .item:last-child { margin-bottom: 0; }

    .item-head {
      display: flex;
      justify-content: space-between;
      gap: 3mm;
      align-items: baseline;
    }

    .org {
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .role, .meta, .when, .detail, .thesis {
      color: var(--muted);
    }

    .when {
      flex: 0 0 auto;
      font-size: 8.3pt;
      font-variant-numeric: tabular-nums;
      color: var(--faint);
    }

    .role, .meta {
      display: block;
      margin-top: 0.2mm;
      font-size: 8.5pt;
    }

    ul.points {
      margin: 0.8mm 0 0;
      padding: 0 0 0 3.2mm;
    }

    ul.points li { margin: 0.35mm 0; }
    ul.points li::marker { color: #b7aad4; }

    .school {
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .thesis {
      margin: 0.45mm 0 0;
      font-size: 8pt;
      line-height: 1.32;
    }

    .thesis a { border-bottom: 0.2mm solid #ddd4ee; }

    .award-title { font-weight: 600; letter-spacing: -0.02em; }
    .detail { display: block; font-size: 8.2pt; }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 1.1mm;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .chips li {
      padding: 0.45mm 1.7mm 0.55mm;
      border-radius: 99px;
      background: var(--chip);
      color: #4e4274;
      font-size: 8.2pt;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .papers {
      margin-top: 0.4mm;
    }

    .paper {
      display: grid;
      grid-template-columns: 15.5mm 1fr;
      gap: 1.6mm;
      margin: 0 0 1.35mm;
      font-size: 8.15pt;
      line-height: 1.32;
    }

    .kind {
      color: var(--accent);
      font-size: 7.6pt;
      font-weight: 700;
      letter-spacing: -0.03em;
      padding-top: 0.25mm;
    }

    .patent-no {
      color: var(--faint);
      font-size: 8.2pt;
    }

    @media screen and (max-width: 860px) {
      body { padding: 0 0 24px; }
      .hint { width: auto; margin: 12px 14px; }
      .sheet {
        width: auto;
        height: auto;
        margin: 0 10px;
        overflow: visible;
      }
      .columns, header, .work-grid { display: block; }
      .photo { margin-bottom: 3mm; }
      .paper { grid-template-columns: 1fr; gap: 0.2mm; }
    }

    @page {
      size: A4;
      margin: 0;
    }

    @media print {
      html, body {
        background: white;
        width: 210mm;
        height: 297mm;
      }
      .hint { display: none; }
      .sheet {
        margin: 0;
        box-shadow: none;
        width: 210mm;
        height: 297mm;
        overflow: hidden;
      }
      a { text-decoration: none; }
      * {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
    }
  </style>
</head>
<body>
  <p class="hint">A4 한 장입니다. 인쇄할 때 여백 없음, 배율 100%로 맞추면 그대로 한 장에 나옵니다.</p>
  <article class="sheet">
    <header>
      <img class="photo" src="{{ photo }}" alt="{{ name_ko }} 프로필 사진">
      <div>
        <div class="name-row">
          <h1>{{ name_ko }}</h1>
          <span class="en">{{ name_en }}</span>
        </div>
        <p class="headline">{{ headline }}</p>
        <ul class="contacts">
          <li><a href="mailto:{{ email }}">{{ email }}</a></li>
          {% for link in links %}
          <li><a href="{{ link.href }}">{{ link.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </header>

    {% if work %}
    <section>
      <h2>주요 업무</h2>
      <div class="work-grid">
        {% for item in work %}
        <div class="work-item">
          <div class="item-head">
            <div class="work-title">{{ item.title }}</div>
            <div class="when">{{ item.period }}</div>
          </div>
          <p>{{ item.summary }}</p>
        </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <div class="columns">
      <div>
        <section>
          <h2>경력</h2>
          {% for job in career %}
          <div class="item">
            <div class="item-head">
              <div class="org">{{ job.org }}</div>
              <div class="when">{{ job.period }}</div>
            </div>
            <span class="role">{{ job.role }}</span>
            {% if job.points %}
            <ul class="points">
              {% for point in job.points %}
              <li>{{ point }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
          {% endfor %}
        </section>

        <section>
          <h2>연구</h2>
          {% for project in projects %}
          <div class="item">
            <div class="org">{{ project.title }}</div>
            <span class="meta">{{ project.meta }}</span>
            {% if project.points %}
            <ul class="points">
              {% for point in project.points %}
              <li>{{ point }}</li>
              {% endfor %}
            </ul>
            {% endif %}
          </div>
          {% endfor %}
        </section>
      </div>

      <div>
        <section>
          <h2>학력</h2>
          {% for edu in education %}
          <div class="item">
            <div class="item-head">
              <div class="school">{{ edu.school }}</div>
              <div class="when">{{ edu.year }}</div>
            </div>
            <span class="role">{{ edu.program }}</span>
            {% if edu.thesis %}
            <p class="thesis">
              {% if edu.thesis_url %}
              <a href="{{ edu.thesis_url }}">{{ edu.thesis }}</a>
              {% else %}
              {{ edu.thesis }}
              {% endif %}
            </p>
            {% endif %}
          </div>
          {% endfor %}
        </section>

        <section>
          <h2>수상 · 자격</h2>
          {% for award in awards %}
          <div class="item">
            <div class="item-head">
              <div class="award-title">
                {% if award.href %}
                <a href="{{ award.href }}">{{ award.title }}</a>
                {% else %}
                {{ award.title }}
                {% endif %}
              </div>
              <div class="when">{{ award.year }}</div>
            </div>
            {% if award.detail %}
            <span class="detail">{{ award.detail }}</span>
            {% endif %}
          </div>
          {% endfor %}
          {% if certificate %}
          <div class="item">
            <div class="award-title">
              {% if certificate.href %}
              <a href="{{ certificate.href }}">{{ certificate.title }}</a>
              {% else %}
              {{ certificate.title }}
              {% endif %}
            </div>
          </div>
          {% endif %}
        </section>

        <section>
          <h2>기술</h2>
          <ul class="chips">
            {% for item in stack %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </section>

        {% if patents %}
        <section>
          <h2>특허</h2>
          {% for patent in patents %}
          <div class="item">
            <div class="item-head">
              <div class="org">{{ patent.title }}</div>
              <div class="when">{{ patent.date }}</div>
            </div>
            <span class="meta">{{ patent.status }}{% if patent.number %} · <span class="patent-no">{{ patent.number }}</span>{% endif %}</span>
          </div>
          {% endfor %}
        </section>
        {% endif %}
      </div>
    </div>

    <section class="papers">
      <h2>논문</h2>
      {% for paper in papers %}
      <div class="paper">
        <div class="kind">{{ paper.kind }}</div>
        <div>{{ paper.text }}</div>
      </div>
      {% endfor %}
    </section>
  </article>
</body>
</html>
